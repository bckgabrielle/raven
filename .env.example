# Gloss provider: groq (default) or meterless
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_TOKEN=
METERLESS_MODEL=nightshift
LLM_TIMEOUT_SECONDS=20

# Optional Zetaris Lightning Catalog REST adapter
ZETARIS_BASE_URL=
ZETARIS_API_TOKEN=

# Local data stays outside Git
ASL_DATASET_ROOT=
ASL_POSE_TRACKS_JSON=
ASL_CHECKPOINT=
ASL_STATE_DIR=
ASL_ADMIN_TOKEN=

# Allowed browser origins for local Next.js development
RAVEN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
